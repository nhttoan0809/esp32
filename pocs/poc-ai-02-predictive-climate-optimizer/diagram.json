{
  "version": 1,
  "author": "toannguyen",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -160,
      "left": 200,
      "attrs": { "label": "DHT11 (DATA: GPIO19)" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -160,
      "left": -150,
      "attrs": { "i2cAddress": "0x3c", "label": "OLED SSD1306 (I2C: GPIO21/22)" }
    },
    {
      "type": "wokwi-ds1307",
      "id": "rtc1",
      "top": -160,
      "left": 20,
      "attrs": { "label": "RTC DS1307 (I2C: GPIO21/22)" }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": 150,
      "left": -150,
      "attrs": { "label": "LDR SENSOR (DO: GPIO35, AO: GPIO34)" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay1",
      "top": 20,
      "left": 230,
      "attrs": { "transistor": "pnp", "label": "RELAY 1 FAN (IN: GPIO26)" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay2",
      "top": 170,
      "left": 230,
      "attrs": { "transistor": "pnp", "label": "RELAY 2 HEAT (IN: GPIO27)" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 240,
      "left": -30,
      "attrs": { "color": "blue", "label": "PAGE/MODE BUTTON (GPIO25)", "key": "p" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_comf",
      "top": -40,
      "left": -150,
      "attrs": { "value": "220", "label": "RESISTOR 220 OHM (GPIO23)" }
    },
    {
      "type": "wokwi-led",
      "id": "led_comf",
      "top": -60,
      "left": -70,
      "attrs": { "color": "green", "label": "COMFORT/WIFI LED (GPIO23)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_warn",
      "top": 30,
      "left": -150,
      "attrs": { "value": "220", "label": "RESISTOR 220 OHM (GPIO18)" }
    },
    {
      "type": "wokwi-led",
      "id": "led_warn",
      "top": 10,
      "left": -70,
      "attrs": { "color": "red", "label": "PRE-COOLING ALERT LED (GPIO18)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_fan",
      "top": 40,
      "left": 360,
      "attrs": { "value": "220", "label": "RESISTOR 220 OHM" }
    },
    {
      "type": "wokwi-led",
      "id": "led_fan",
      "top": 20,
      "left": 440,
      "attrs": { "color": "blue", "label": "FAN LOAD SIMULATION" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_heat",
      "top": 190,
      "left": 360,
      "attrs": { "value": "220", "label": "RESISTOR 220 OHM" }
    },
    {
      "type": "wokwi-led",
      "id": "led_heat",
      "top": 170,
      "left": 440,
      "attrs": { "color": "yellow", "label": "HEAT LOAD SIMULATION" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "dht1:VCC", "esp:3V3", "red", [ "h-10", "v120" ] ],
    [ "dht1:GND", "esp:GND.2", "black", [ "h-20", "v100" ] ],
    [ "dht1:SDA", "esp:D19", "gold", [ "h-40", "v80" ] ],

    [ "oled1:VCC", "esp:3V3", "red", [ "v20", "h60" ] ],
    [ "oled1:GND", "esp:GND.1", "black", [ "v30", "h50" ] ],
    [ "oled1:SDA", "esp:D21", "blue", [ "v40", "h80" ] ],
    [ "oled1:SCL", "esp:D22", "yellow", [ "v50", "h90" ] ],

    [ "rtc1:5V", "esp:3V3", "red", [ "v30", "h-20" ] ],
    [ "rtc1:GND", "esp:GND.1", "black", [ "v40", "h-30" ] ],
    [ "rtc1:SDA", "esp:D21", "blue", [ "v50", "h60" ] ],
    [ "rtc1:SCL", "esp:D22", "yellow", [ "v60", "h70" ] ],

    [ "ldr1:VCC", "esp:3V3", "red", [ "h20", "v-80" ] ],
    [ "ldr1:GND", "esp:GND.1", "black", [ "h30", "v-100" ] ],
    [ "ldr1:DO", "esp:D35", "cyan", [ "h40", "v-110" ] ],
    [ "ldr1:AO", "esp:D34", "purple", [ "h50", "v-120" ] ],

    [ "esp:D26", "relay1:IN", "blue", [ "h20" ] ],
    [ "esp:VIN", "relay1:VCC", "red", [ "v20", "h60" ] ],
    [ "esp:GND.2", "relay1:GND", "black", [ "v30", "h50" ] ],
    [ "relay1:COM", "esp:VIN", "red", [ "v10", "h-40" ] ],
    [ "relay1:NO", "r_fan:1", "blue", [ "h20" ] ],
    [ "r_fan:2", "led_fan:A", "blue", [ "h10" ] ],
    [ "led_fan:C", "esp:GND.2", "black", [ "v40", "h-200" ] ],

    [ "esp:D27", "relay2:IN", "orange", [ "h20" ] ],
    [ "esp:VIN", "relay2:VCC", "red", [ "v40", "h60" ] ],
    [ "esp:GND.2", "relay2:GND", "black", [ "v50", "h50" ] ],
    [ "relay2:COM", "esp:VIN", "red", [ "v10", "h-40" ] ],
    [ "relay2:NO", "r_heat:1", "orange", [ "h20" ] ],
    [ "r_heat:2", "led_heat:A", "orange", [ "h10" ] ],
    [ "led_heat:C", "esp:GND.2", "black", [ "v40", "h-200" ] ],

    [ "esp:D25", "btn1:1.r", "blue", [ "v20" ] ],
    [ "btn1:2.r", "esp:GND.1", "black", [ "v20", "h-20" ] ],

    [ "esp:D23", "r_comf:1", "green", [ "h-20" ] ],
    [ "r_comf:2", "led_comf:A", "green", [ "h10" ] ],
    [ "led_comf:C", "esp:GND.1", "black", [ "v20", "h40" ] ],

    [ "esp:D18", "r_warn:1", "red", [ "h-20" ] ],
    [ "r_warn:2", "led_warn:A", "red", [ "h10" ] ],
    [ "led_warn:C", "esp:GND.1", "black", [ "v20", "h40" ] ]
  ]
}
