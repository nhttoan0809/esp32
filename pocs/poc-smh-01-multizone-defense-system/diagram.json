{
  "version": 1,
  "author": "toannguyen",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "board-mfrc522",
      "id": "rfid1",
      "top": -220,
      "left": 240,
      "attrs": { "label": "RFID RC522 (SPI: CS=D5, RST=D4)", "uid": "DE:AD:BE:EF" }
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir1",
      "top": -220,
      "left": -220,
      "attrs": {}
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_ir",
      "top": -60,
      "left": -220,
      "attrs": { "color": "orange", "key": "i", "label": "ZONE 2: IR BEAM BREAKER SIM (GPIO35)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_pu_ir",
      "top": -30,
      "left": -120,
      "attrs": { "value": "10000" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_snd",
      "top": 60,
      "left": -220,
      "attrs": { "color": "blue", "key": "s", "label": "ZONE 3: SOUND BREACH SIM (GPIO39)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_pu_snd",
      "top": 90,
      "left": -120,
      "attrs": { "value": "10000" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_arm",
      "top": 180,
      "left": -220,
      "attrs": { "color": "yellow", "key": "a", "label": "PANIC / ARM TOGGLE (GPIO13)" }
    },
    {
      "type": "wokwi-ssd1306",
      "id": "oled1",
      "top": -60,
      "left": 240,
      "attrs": {}
    },
    {
      "type": "wokwi-ds1307",
      "id": "rtc1",
      "top": 100,
      "left": 240,
      "attrs": {}
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay1",
      "top": 240,
      "left": 240,
      "attrs": {}
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay2",
      "top": 360,
      "left": 240,
      "attrs": {}
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": 300,
      "left": -220,
      "attrs": {}
    },
    {
      "type": "wokwi-resistor",
      "id": "r_led_red",
      "top": 400,
      "left": -120,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_red",
      "top": 390,
      "left": -40,
      "attrs": { "color": "red", "label": "ARMED/ALARM LED (GPIO2)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_led_grn",
      "top": 450,
      "left": -120,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_grn",
      "top": 440,
      "left": -40,
      "attrs": { "color": "green", "label": "DISARMED LED (GPIO15)" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "pir1:VCC", "esp:VIN", "red", [ "h20", "v120" ] ],
    [ "pir1:GND", "esp:GND.1", "black", [ "h30", "v110" ] ],
    [ "pir1:OUT", "esp:D34", "yellow", [ "h40", "v100" ] ],

    [ "btn_ir:1.l", "esp:D35", "gold", [ "h30", "v20" ] ],
    [ "btn_ir:2.l", "esp:GND.1", "black", [ "h20", "v10" ] ],
    [ "r_pu_ir:1", "esp:3V3", "red", [ "h10", "v20" ] ],
    [ "r_pu_ir:2", "esp:D35", "gold", [ "h0" ] ],

    [ "btn_snd:1.l", "esp:VN", "blue", [ "h30", "v-20" ] ],
    [ "btn_snd:2.l", "esp:GND.1", "black", [ "h20", "v-30" ] ],
    [ "r_pu_snd:1", "esp:3V3", "red", [ "h10", "v-20" ] ],
    [ "r_pu_snd:2", "esp:VN", "blue", [ "h0" ] ],

    [ "btn_arm:1.l", "esp:D13", "yellow", [ "h50", "v-20" ] ],
    [ "btn_arm:2.l", "esp:GND.1", "black", [ "h40", "v-30" ] ],

    [ "rfid1:3.3V", "esp:3V3", "red", [ "h-10", "v120" ] ],
    [ "rfid1:GND", "esp:GND.1", "black", [ "h-20", "v110" ] ],
    [ "rfid1:RST", "esp:D4", "orange", [ "h-30", "v80" ] ],
    [ "rfid1:SDA", "esp:D5", "yellow", [ "h-40", "v70" ] ],
    [ "rfid1:SCK", "esp:D18", "blue", [ "h-50", "v60" ] ],
    [ "rfid1:MISO", "esp:D19", "purple", [ "h-60", "v50" ] ],
    [ "rfid1:MOSI", "esp:D23", "cyan", [ "h-70", "v40" ] ],

    [ "oled1:3V3", "esp:3V3", "red", [ "h-20", "v100" ] ],
    [ "oled1:GND", "esp:GND.2", "black", [ "h-30", "v90" ] ],
    [ "oled1:DATA", "esp:D21", "green", [ "h-40", "v60" ] ],
    [ "oled1:CLK", "esp:D22", "blue", [ "h-50", "v50" ] ],

    [ "rtc1:5V", "esp:VIN", "red", [ "h-20", "v-20" ] ],
    [ "rtc1:GND", "esp:GND.2", "black", [ "h-30", "v-30" ] ],
    [ "rtc1:SDA", "esp:D21", "green", [ "h-40", "v-50" ] ],
    [ "rtc1:SCL", "esp:D22", "blue", [ "h-50", "v-60" ] ],

    [ "relay1:VCC", "esp:VIN", "red", [ "h-30", "v-150" ] ],
    [ "relay1:GND", "esp:GND.2", "black", [ "h-40", "v-160" ] ],
    [ "relay1:IN", "esp:D26", "orange", [ "h-50", "v-120" ] ],

    [ "relay2:VCC", "esp:VIN", "red", [ "h-30", "v-250" ] ],
    [ "relay2:GND", "esp:GND.2", "black", [ "h-40", "v-260" ] ],
    [ "relay2:IN", "esp:D27", "purple", [ "h-50", "v-220" ] ],

    [ "esp:D25", "bz1:2", "magenta", [ "h-40", "v0" ] ],
    [ "bz1:1", "esp:GND.1", "black", [ "h-20", "v120" ] ],

    [ "esp:D2", "r_led_red:1", "red", [ "h-20" ] ],
    [ "r_led_red:2", "led_red:A", "red", [ "h10" ] ],
    [ "led_red:C", "esp:GND.2", "black", [ "v20", "h100" ] ],

    [ "esp:D15", "r_led_grn:1", "green", [ "h-20" ] ],
    [ "r_led_grn:2", "led_grn:A", "green", [ "h10" ] ],
    [ "led_grn:C", "esp:GND.2", "black", [ "v20", "h100" ] ]
  ]
}
