# ==============================================================================
# ESPHome Secrets Example
# Copy to secrets.yaml and adjust according to your local Wi-Fi and Self-Hosted Server
# ==============================================================================

wifi_ssid: "Your_Local_WiFi_SSID"
wifi_password: "Your_Local_WiFi_Password"

# IP Address of your Self-Hosted Server (e.g. 192.168.1.100 or 10.0.0.x)
mqtt_broker_ip: "192.168.1.100"
