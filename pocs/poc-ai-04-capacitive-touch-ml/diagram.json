  "connections": [
    ["esp:TX0", "$serialMonitor:RX", "", []],
    ["esp:RX0", "$serialMonitor:TX", "", []],

    ["esp:D23", "matrix1:DIN", "green", ["v0"]],
    ["esp:D18", "matrix1:CLK", "orange", ["v0"]],
    ["esp:D5", "matrix1:CS", "blue", ["v0"]],
    ["esp:VIN", "matrix1:V+", "red", ["v-20", "h0"]],
    ["esp:GND.1", "matrix1:GND", "black", ["v-30", "h0"]],

    ["esp:D4", "btn0:1.r", "blue", ["h0"]],
    ["btn0:2.r", "esp:GND.1", "black", ["h0"]],

    ["esp:D13", "btn1:1.r", "green", ["h0"]],
    ["btn1:2.r", "esp:GND.1", "black", ["h0"]],

    ["esp:D14", "btn2:1.r", "gold", ["h0"]],
    ["btn2:2.r", "esp:GND.1", "black", ["h0"]],

    ["esp:D27", "btn3:1.r", "red", ["h0"]],
    ["btn3:2.r", "esp:GND.1", "black", ["h0"]],

    ["esp:D25", "relay1:IN", "purple", ["h0"]],
    ["esp:VIN", "relay1:VCC", "red", ["v20", "h0"]],
    ["esp:GND.1", "relay1:GND", "black", ["v30", "h0"]],
    ["relay1:COM", "esp:VIN", "red", ["v10", "h0"]],
    ["relay1:NO", "rLamp:1", "yellow", ["h0"]],
    ["rLamp:2", "ledLamp:A", "yellow", ["h0"]],
    ["ledLamp:C", "esp:GND.1", "black", ["v50", "h0"]],

    ["esp:D26", "relay2:IN", "cyan", ["h0"]],
    ["esp:VIN", "relay2:VCC", "red", ["v20", "h0"]],
    ["esp:GND.1", "relay2:GND", "black", ["v30", "h0"]],
    ["relay2:COM", "esp:VIN", "red", ["v10", "h0"]],
    ["relay2:NO", "rFan:1", "blue", ["h0"]],
    ["rFan:2", "ledFan:A", "blue", ["h0"]],
    ["ledFan:C", "esp:GND.1", "black", ["v60", "h0"]]
  ]
}
